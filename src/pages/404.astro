---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
  title="Page not found"
  description="That page doesn't exist on sifatullah.me. Head back to the home page."
>
  <section class="container notfound">
    <h1>404 — page not found</h1>
    <p>That page doesn't exist. Try the <a href="/">home page</a> or the <a href="/cv">CV</a>.</p>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(4rem, 3rem + 8vw, 9rem);
  }
</style>
