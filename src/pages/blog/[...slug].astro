---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_URL } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const df = new Intl.DateTimeFormat('en', { dateStyle: 'long' });

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  ...(data.updatedDate ? { dateModified: data.updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: SITE_TITLE, url: SITE_URL },
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogType="article"
  image={data.ogImage}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonld)}
  />

  <article class="post container">
    <p class="post__back"><a href="/blog">← Blog</a></p>
    <header class="post__header">
      <h1>{data.title}</h1>
      <p class="post__meta">
        <time datetime={data.pubDate.toISOString()}>{df.format(data.pubDate)}</time>
        {data.updatedDate && <> · updated {df.format(data.updatedDate)}</>}
      </p>
    </header>
    <div class="post__body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 42rem;
    padding-block: clamp(2rem, 1rem + 4vw, 4rem);
  }
  .post__back {
    margin: 0 0 2rem;
    font-size: var(--step--1);
  }
  .post__back a {
    text-decoration: none;
    color: var(--text-muted);
  }
  .post__back a:hover {
    color: var(--text);
  }
  .post__meta {
    color: var(--text-muted);
    font-size: var(--step--1);
    margin: 0.5rem 0 0;
  }
  .post__body {
    margin-top: 2.5rem;
  }
  .post__body :global(h2) {
    font-size: var(--step-1);
    margin: 2.25rem 0 0.6rem;
  }
  .post__body :global(h3) {
    font-size: var(--step-0);
    margin: 1.75rem 0 0.4rem;
  }
  .post__body :global(p),
  .post__body :global(ul),
  .post__body :global(ol) {
    margin: 0 0 1.1rem;
  }
  .post__body :global(ul),
  .post__body :global(ol) {
    padding-left: 1.2rem;
  }
  .post__body :global(li) {
    margin-bottom: 0.4rem;
  }
  .post__body :global(code) {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05em 0.35em;
    font-size: 0.9em;
  }
  .post__body :global(a) {
    text-underline-offset: 0.2em;
  }
</style>
