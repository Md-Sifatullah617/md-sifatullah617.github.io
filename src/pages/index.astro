---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Ventures from '../components/Ventures.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import PersonSchema from '../components/PersonSchema.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} ogType="profile">
  <PersonSchema slot="head" />
  <Hero />
  <SelectedWork />
  <Ventures />
  <About />
  <Contact />
</BaseLayout>
