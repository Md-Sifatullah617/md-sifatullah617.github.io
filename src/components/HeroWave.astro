<style>
  .hero-wave {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .hero-wave svg {
    width: 100%;
    height: 100%;
  }
  .hero-wave :global(.wave-glow path) {
    fill: none;
    stroke: url(#hero-wave-gradient);
    filter: blur(4px);
  }
  .hero-wave :global(.wave-crisp path) {
    fill: none;
    stroke: url(#hero-wave-gradient);
  }
  /* Faithful to the reference gradient in both themes; opacity trimmed a touch
     on light so it reads as line art rather than competing with body text. */
  :root[data-theme='light'] .hero-wave {
    opacity: 0.8;
  }
</style>
