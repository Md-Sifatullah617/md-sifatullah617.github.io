---
import { EMAIL } from '../consts';

// Owner-supplied: set the PUBLIC_FORMSPREE_ID repo variable (Settings > Secrets
// and variables > Actions > Variables) to the Formspree form ID. Until it's set,
// the raw env value is '' (GitHub Actions substitutes an unset repo variable
// with an empty string, not undefined) — trim() catches that, `??` alone would not.
const rawId = import.meta.env.PUBLIC_FORMSPREE_ID?.trim();
const isConfigured = !!rawId;
const formAction = isConfigured ? `https://formspree.io/f/${rawId}` : undefined;
---

<section id="contact" class="contact">
  <div class="container contact__inner">
    <h2>Contact</h2>
    <div class="contact__body">
      <p class="contact__open">
        Open to advising, hard backend and mobile problems, and Manobsheba
        partnerships.
      </p>

      {
        isConfigured ? (
          <form class="contact__form" action={formAction} method="POST">
            <label>
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
            <label>
              <span>Message</span>
              <textarea name="message" rows="5" required />
            </label>
            <p class="contact__hp" aria-hidden="true">
              <label>
                Leave this field empty
                <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
              </label>
            </p>
            <div class="contact__actions">
              <button type="submit" class="btn btn--primary">
                Send
              </button>
              <a class="btn" href={`mailto:${EMAIL}`}>
                Email me
              </a>
            </div>
          </form>
        ) : (
          <div class="contact__actions">
            <a class="btn btn--primary" href={`mailto:${EMAIL}`}>
              Email me
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    border-top: 1px solid var(--border);
  }
  .contact__inner {
    display: grid;
    gap: 1.5rem 3rem;
  }
  @media (min-width: 48rem) {
    .contact__inner {
      grid-template-columns: 12rem 1fr;
    }
  }
  .contact__body {
    max-width: 34rem;
  }
  .contact__open {
    margin: 0 0 1.75rem;
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .contact__form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: var(--step--1);
  }
  .contact__form input,
  .contact__form textarea {
    font: inherit;
    color: var(--text);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.6rem 0.7rem;
  }
  .contact__form input:focus-visible,
  .contact__form textarea:focus-visible {
    border-color: var(--focus);
  }
  .contact__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
