---
import { Image } from 'astro:assets';
import headshot from '../../assets/images/sifat-portrait.webp';
import { EMAIL, LINKEDIN, APPS } from '../consts';

// Hero background: the flowing wave from yujisatojr/react-portfolio-template's
// bg-dark.png, used as-is (recreated faithfully, not redrawn) — pre-flattened
// onto black and re-encoded to mozjpeg in public/hero-wave-dark.jpg (420KB PNG
// -> 53KB; webp was worse than PNG here, 859KB, because of the alpha channel).
// Always the dark variant, in both site themes — see the --text overrides
// below for why.
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__body">
      <p class="hero__eyebrow">Md Sifatullah</p>
      <h1>I build production software <span class="nowrap">end-to-end</span> and lead the people who ship it.</h1>
      <p class="hero__roles">
        Software Engineer at <strong>Metal&nbsp;Plus</strong>.
        CTO at <strong>Manobsheba</strong> <span class="hero__note">(private beta)</span>.
        Founding a software studio.
      </p>
      <p class="hero__prev">Previously Mulytic Energy, DeshIT-BD.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={`mailto:${EMAIL}`}>Email me</a>
        <a class="btn" href={LINKEDIN} rel="me">LinkedIn</a>
      </div>
      <p class="hero__apps">
        <span class="hero__apps-label">Shipped to the stores:</span>{' '}
        {
          APPS.map((app, i) => (
            <>
              {i > 0 && <span class="hero__apps-sep">{'  ·  '}</span>}
              <span class="hero__apps-app">{app.name}</span>
              {' — '}
              {app.stores.map((s, j) => (
                <>
                  {j > 0 && <span aria-hidden="true">{' / '}</span>}
                  <a href={s.url} target="_blank" rel="noopener">
                    {s.label}
                  </a>
                </>
              ))}
            </>
          ))
        }
      </p>
    </div>
    <Image
      class="hero__photo"
      src={headshot}
      alt="Md Sifatullah"
      widths={[320, 520, 760]}
      sizes="(max-width: 720px) 60vw, 20rem"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    /* The wave is a fixed dark banner regardless of site theme — both of the
       template's own background variants are near-black (bg-light.png is
       still black, just with white instead of purple lines), so following
       the light/dark toggle here would put dark theme-token text on a black
       hero in "light" mode. Pin dark-theme-equivalent tokens locally instead;
       everything below already reads through var(--text) etc. */
    --text: #e8e8ea;
    --text-muted: #a0a0a8;
    --border: #2a2c33;
    --accent: #e8a33d;
    --accent-text: #0e0f12;
    /* h1 and other hero text with no color of their own inherit body's
       already-computed `color` (resolved against :root), not a fresh lookup
       against the --text redefined above — set color here explicitly so the
       override actually reaches them. */
    color: var(--text);
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 6vw, 6rem);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/hero-wave-dark.jpg');
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap-reverse;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 1rem + 4vw, 4rem);
  }
  .hero__body {
    flex: 1 1 22rem;
  }
  .hero__eyebrow {
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .hero h1 {
    max-width: 18ch;
  }
  .nowrap {
    white-space: nowrap;
  }
  .hero__roles {
    font-size: var(--step-1);
    max-width: 34ch;
    color: var(--text);
  }
  .hero__note {
    color: var(--text-muted);
  }
  .hero__prev {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero__apps {
    margin: 1rem 0 0;
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.7;
  }
  .hero__apps-label {
    color: var(--text);
    font-weight: 500;
  }
  .hero__apps-app {
    color: var(--text);
  }
  .hero__apps a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }
  .hero__apps a:hover {
    text-decoration-color: var(--accent);
  }
  .hero__photo {
    flex: 0 1 auto;
    width: clamp(12rem, 8rem + 16vw, 20rem);
    height: auto;
    aspect-ratio: 864 / 1124;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
</style>
